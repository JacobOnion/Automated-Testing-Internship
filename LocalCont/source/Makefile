# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  OpenGLProject_config = debug
  RunSubmission_config = debug
  ScreenGrab_config = debug

else ifeq ($(config),release)
  OpenGLProject_config = release
  RunSubmission_config = release
  ScreenGrab_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := ScreenGrab RunSubmission OpenGLProject

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

OpenGLProject:
ifneq (,$(OpenGLProject_config))
	@echo "==== Building OpenGLProject ($(OpenGLProject_config)) ===="
	@${MAKE} --no-print-directory -C . -f OpenGLProject.make config=$(OpenGLProject_config)
endif

RunSubmission:
ifneq (,$(RunSubmission_config))
	@echo "==== Building RunSubmission ($(RunSubmission_config)) ===="
	@${MAKE} --no-print-directory -C . -f RunSubmission.make config=$(RunSubmission_config)
endif

ScreenGrab:
ifneq (,$(ScreenGrab_config))
	@echo "==== Building ScreenGrab ($(ScreenGrab_config)) ===="
	@${MAKE} --no-print-directory -C . -f ScreenGrab.make config=$(ScreenGrab_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f OpenGLProject.make clean
	@${MAKE} --no-print-directory -C . -f RunSubmission.make clean
	@${MAKE} --no-print-directory -C . -f ScreenGrab.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   OpenGLProject"
	@echo "   RunSubmission"
	@echo "   ScreenGrab"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"